{
  "name": "darsak",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/admin"
  ],
  "description": "DarSak connects students and teachers through bilingual profiles, learning groups, interactive schedules, and organized resources.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:admin": "npm run build --workspace @darsak/admin",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:admin": "npm run typecheck --workspace @darsak/admin",
    "boundaries": "node scripts/admin-boundary.mjs",
    "actions:guard": "node scripts/server-action-guard.mjs",
    "test": "vitest run",
    "eval:assistant": "node scripts/assistant-offline-eval.mjs && vitest run tests/unit/assistant-eval.test.ts tests/unit/assistant-provider.test.ts",
    "e2e": "node tests/e2e/support/run.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.62.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "nodemailer": "10.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-security": "4.2.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "license": "MIT"
}
