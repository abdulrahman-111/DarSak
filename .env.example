NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
AUTH_RECOVERY_SECRET=

# Optional server-only values. Never expose these through NEXT_PUBLIC_* variables.
# Configure them in production hosting only when enabling the corresponding worker.
SUPABASE_SERVICE_ROLE_KEY=
GMAIL_APP_PASSWORD=
CRON_SECRET=
ACCOUNT_DELETION_WORKER_SECRET=

# SanDak (سندك) study assistant. Server-only; never NEXT_PUBLIC_*.
# Live AI is on only when SANAD_ENABLED=true AND GEMINI_API_KEY is set.
# Otherwise the companion still shows local guided help. See docs/ASSISTANT.md.
SANAD_ENABLED=false
GEMINI_API_KEY=
# Optional quota overrides (defaults shown).
# SANAD_USER_DAILY_LIMIT=60
# SANAD_USER_MINUTE_LIMIT=10
# SANAD_GLOBAL_DAILY_LIMIT=3000
# SANAD_GLOBAL_CONCURRENCY=10
