APP_ENV=development
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_EXPECTED_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_EXPECTED_PROJECT_REF=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
AUTH_RECOVERY_SECRET=

# Optional server-only values. Never expose these through NEXT_PUBLIC_* variables.
# Configure them in production hosting only when enabling the corresponding worker.
SUPABASE_SERVICE_ROLE_KEY=
GMAIL_APP_PASSWORD=
CRON_SECRET=
ACCOUNT_DELETION_WORKER_SECRET=

# Sanad adult-tester pilot: separate staging project only; never NEXT_PUBLIC_*.
# Enroll matching UUIDs in private.sanad_pilot_testers through an operator.
SANAD_ENABLED=false
SANAD_PILOT_USER_IDS=
GEMINI_API_KEY=

# Before any future merge to main, configure the main Vercel project explicitly:
# APP_ENV=production
# NEXT_PUBLIC_APP_ENV=production
# VERCEL_ENV=production (provided by Vercel's Production deployment target)
# SUPABASE_EXPECTED_PROJECT_REF=ubrvjjibibqaiomrvwbd
# NEXT_PUBLIC_SUPABASE_EXPECTED_PROJECT_REF=ubrvjjibibqaiomrvwbd
# NEXT_PUBLIC_SUPABASE_URL=https://ubrvjjibibqaiomrvwbd.supabase.co
# NEXT_PUBLIC_SITE_URL=https://darsak-platform.vercel.app
